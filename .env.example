# Discord webhook for notifications. Use comma or newline separated URLs for multiple destinations.
DISCORD_WEBHOOK_URL=

# Set to require login before viewing the site.
APP_PASSWORD=
# Optional. Defaults to APP_PASSWORD when omitted.
APP_SESSION_SECRET=

# Vercel deployment persistence. Created automatically by `vercel blob create-store`.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_PATH=kindle-price-watch/store.json
# Short in-process cache for Blob reads. Reduces Fast Origin Transfer during UI/API bursts.
BLOB_STORE_MEMORY_CACHE_MS=15000
# Keep only recent immutable UI/control payload generations.
BLOB_DERIVED_PAYLOAD_RETENTION=16
BLOB_DERIVED_PAYLOAD_MEMORY_CACHE_MS=15000
# Keep price history compact by storing changes only and retaining recent states per book.
PRICE_HISTORY_MAX_ENTRIES_PER_BOOK=120

# Price provider: amazon_html, auto, keepa
PRICE_PROVIDER=amazon_html

# Optional paid providers.
KEEPA_API_KEY=

# Japan marketplace defaults.
AMAZON_DOMAIN=JP
AMAZON_HOST=www.amazon.co.jp

# Local server.
PORT=4173
# Optional: pace large checks so Amazon and supplemental sources are less likely to block the run.
CHECK_REQUEST_DELAY_MS=2200
CHECK_REQUEST_JITTER_MS=1800
CHECK_BLOCK_COOLDOWN_MS=90000
HTTP_REQUEST_MIN_INTERVAL_MS=900
HTTP_REQUEST_JITTER_MS=900
HTTP_BLOCK_COOLDOWN_MS=90000
HTTP_AMAZON_FETCH_RETRIES=1
HTTP_FETCH_RETRY_DELAY_MS=1000
# Keep enough of each book's runtime budget for listasIn/Kintyaku fallbacks.
AMAZON_DIRECT_PHASE_TIMEOUT_MS=20000
AMAZON_TIMEOUT_FALLBACK_THRESHOLD=2
# Optional: comma or newline separated browser user agents for Amazon HTML fetches.
# AMAZON_USER_AGENTS=
# Optional: proxy endpoint for Amazon HTML fetches. Use {url} as the encoded target placeholder.
# AMAZON_HTML_PROXY_URL_TEMPLATE=https://example.com/fetch?url={url}
# Optional: stop a check run before the hosting platform hard timeout.
# CHECK_MAX_RUNTIME_MS=8000

# Optional: limit imported books from a series URL. Leave unset for no app-side limit.
# SERIES_IMPORT_LIMIT=100
# Optional: queue book/series imports into the next scheduled GitHub Actions run.
BOOK_IMPORT_QUEUE_PATH=data/import-queue.txt
# BOOK_IMPORT_INPUTS=
# Optional: how often scheduled runs should scan registered series pages for new volumes.
SERIES_DISCOVERY_INTERVAL_HOURS=24

# Keep false on Vercel Hobby unless series are small. Details are filled by later price checks.
SERIES_IMPORT_FETCH_DETAILS=false
