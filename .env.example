# Discord webhook for notifications. Use comma or newline separated URLs for multiple destinations.
DISCORD_WEBHOOK_URL=

# Set to require login before viewing the site.
APP_PASSWORD=
# Optional. Defaults to APP_PASSWORD when omitted.
APP_SESSION_SECRET=

# Vercel deployment persistence. Created automatically by `vercel blob create-store`.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_PATH=kindle-price-watch/store.json

# Optional alternative persistence. If Supabase is set, it takes priority over Blob.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Vercel Cron can call /api/cron/check with this bearer token.
CRON_SECRET=

# Price provider: amazon_html, auto, keepa
PRICE_PROVIDER=amazon_html

# Optional paid providers.
KEEPA_API_KEY=

# Japan marketplace defaults.
AMAZON_DOMAIN=JP
AMAZON_HOST=www.amazon.co.jp

# Server and scheduler.
PORT=4173
AUTO_CHECK_ENABLED=true
CHECK_INTERVAL_HOURS=24
CHECK_BATCH_SIZE=50
# Optional: number of books checked in parallel per run.
CHECK_CONCURRENCY=1
# Optional: stop a check run before the hosting platform hard timeout.
# CHECK_MAX_RUNTIME_MS=8000

# Optional: limit imported books from a series URL. Leave unset for no app-side limit.
# SERIES_IMPORT_LIMIT=100

# Keep false on Vercel Hobby unless series are small. Details are filled by later price checks.
SERIES_IMPORT_FETCH_DETAILS=false
